han","level":"Kab","question":"3¾ ÷ 1¼ = …","options":{"A":"3","B":"4","C":"4⅔","D":"3¼"},"answerKey":"A","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":35,"subTopic":"Latihan","level":"Kab","question":"Hasil 1⅛ + 2⅜ + 1½ adalah …","options":{"A":"5","B":"4½","C":"4⅞","D":"5⅛"},"answerKey":"A","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":36,"subTopic":"Latihan","level":"Kab","question":"Berapa banyak pecahan campuran berikut yang lebih besar dari 2? **(2¼, 1¾, 2⅕, ⅞ + 1)**","options":{"A":"1","B":"2","C":"3","D":"4"},"answerKey":"B","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":37,"subTopic":"Latihan","level":"Kab","question":"4⅙ − 1⅔ = …","options":{"A":"2½","B":"3⅙","C":"2⅔","D":"5⅚"},"answerKey":"A","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":38,"subTopic":"Latihan","level":"Kab","question":"Hasil 2 + 1¾ adalah …","options":{"A":"2¾","B":"3¾","C":"4¾","D":"3¼"},"answerKey":"B","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":39,"subTopic":"Latihan","level":"Kab","question":"Hasil 5 − 2⅔ adalah …","options":{"A":"2⅓","B":"3⅓","C":"2⅔","D":"3⅔"},"answerKey":"A","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":40,"subTopic":"Latihan","level":"Kab","question":"Bentuk paling sederhana dari 24/10 sebagai campuran adalah …","options":{"A":"2 4/10","B":"2⅖","C":"2⅕","D":"2½"},"answerKey":"B","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":41,"subTopic":"Latihan","level":"Kab","question":"Sebuah pita 1¼ m disambung dengan pita 2⅜ m. Panjang total adalah …","options":{"A":"3⅛ m","B":"3¼ m","C":"3¾ m","D":"3⅝ m"},"answerKey":"D","concept":"","analysis":{"A":"","B":"","C":"","D":""},"steps":[],"tips":""},{"number":42,"subTopic":"Latihan","level":"Kab","question":"Hasil 6⅖ ÷ 2 = …","options":{"A":"4⅕","B":"